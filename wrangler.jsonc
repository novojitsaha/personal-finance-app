/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "personal-finance-app",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application"
	},
	// Only public entry point is the custom domain, which sits behind Cloudflare Access.
	// workers.dev and preview URLs are disabled so Access can't be bypassed.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "finance.novojitsaha.com", "custom_domain": true }],
	/**
	 * Bindings
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "personal-finance-db",
			"database_id": "3b0dc861-dbcb-437d-900e-f8183f003db4"
		}
	],
	"r2_buckets": [
		{
			"binding": "STATEMENTS",
			"bucket_name": "personal-finance-statements"
		}
	],
	// Workers AI has no local simulation; "remote" makes `npm run dev` call the
	// real models (billed like production use).
	"ai": { "binding": "AI", "remote": true },
	// Durable, retryable processing of uploaded statements.
	"workflows": [
		{
			"name": "statement-processing",
			"binding": "STATEMENT_WORKFLOW",
			"class_name": "StatementWorkflow"
		}
	]
}
